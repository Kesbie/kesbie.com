---
import { getHomePath, useTranslations, type Lang } from '../i18n/utils';
import { site } from '../i18n/site';
import { sites } from '../lib/sites';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const name = lang === 'vi' ? site.name : site.nameEn;
---

<div class="page">
	<header class="topbar">
		<a class="brand" href={getHomePath(lang)}>
			{name}
		</a>
		<div class="controls">
			<LanguageSwitcher lang={lang} />
			<ThemeToggle lang={lang} />
		</div>
	</header>

	<main id="main" class="main">
		<p class="greeting">{t('hero.greeting')}</p>
		<h1 class="name">{name}</h1>
		<p class="role">{t('hero.role')}</p>
		<p class="intro">{t('hero.intro')}</p>

		<ul class="site-list">
			{
				sites.map((item) => (
					<li>
						<a class="site-link" href={item.url} target="_blank" rel="noopener noreferrer">
							<span class="link-text">{item.label}</span>
							<span class="arrow" aria-hidden="true">↗</span>
						</a>
					</li>
				))
			}
		</ul>
	</main>
</div>

<style>
	.page {
		display: flex;
		flex-direction: column;
		min-height: 100dvh;
		width: 100%;
		max-width: 44rem;
		margin-inline: auto;
		padding: clamp(1.25rem, 5vw, 3rem);
	}

	.topbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-bottom: 1.5rem;
	}

	.brand {
		font-size: 0.92rem;
		font-weight: 600;
		text-decoration: none;
		color: var(--fg-muted);
		transition: color 0.2s ease;
	}

	.brand:hover {
		color: var(--fg);
	}

	.controls {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.main {
		flex: 1;
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding-bottom: clamp(2rem, 6vh, 4rem);
	}

	.greeting {
		margin: 0;
		font-size: 0.85rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.name {
		margin: 0.35rem 0 0;
		font-size: clamp(2rem, 6vw, 2.9rem);
		font-weight: 700;
		line-height: 1.15;
		letter-spacing: -0.03em;
	}

	.role {
		margin: 0.35rem 0 0;
		color: var(--fg-muted);
	}

	.intro {
		margin: 1.25rem 0 0;
		max-width: 46ch;
		color: var(--fg-muted);
	}

	.site-list {
		margin: 2.5rem 0 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--border);
	}

	.site-list li {
		border-bottom: 1px solid var(--border);
	}

	.site-link {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.85rem 0.25rem;
		text-decoration: none;
		transition:
			color 0.2s ease,
			padding-left 0.2s ease;
	}

	.site-link:hover {
		color: var(--accent);
		padding-left: 0.6rem;
	}

	.link-text {
		font-size: 1rem;
		font-variant-numeric: tabular-nums;
	}

	.arrow {
		font-size: 0.9rem;
		color: var(--fg-muted);
		transition: transform 0.2s ease;
	}

	.site-link:hover .arrow {
		color: var(--accent);
		transform: translate(2px, -2px);
	}
</style>
