---
import { getHomePath, htmlLang, useTranslations, type Lang } from '../i18n/utils';
import { site } from '../i18n/site';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const pageTitle = t('site.title');
const pageDescription = t('site.description');

const localizedUrl = (locale: Lang) => new URL(getHomePath(locale), site.url).href;
---

<!doctype html>
<html lang={htmlLang(lang)}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0b0e13" media="(prefers-color-scheme: dark)" />
		<meta name="generator" content={Astro.generator} />

		<title>{pageTitle}</title>
		<meta name="description" content={pageDescription} />
		<link rel="canonical" href={localizedUrl(lang)} />
		<link rel="alternate" hreflang="vi" href={localizedUrl('vi')} />
		<link rel="alternate" hreflang="en" href={localizedUrl('en')} />
		<link rel="alternate" hreflang="x-default" href={localizedUrl('vi')} />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:url" content={localizedUrl(lang)} />
		<meta property="og:image" content={new URL('/android-chrome-512x512.png', site.url).href} />
		<meta property="og:locale" content={lang === 'vi' ? 'vi_VN' : 'en_US'} />
		<meta property="og:locale:alternate" content={lang === 'vi' ? 'en_US' : 'vi_VN'} />
		<meta name="twitter:card" content="summary_large_image" />

		<script is:inline>
			// Applies the stored theme before first paint so there is no flash.
			(() => {
				try {
					const stored = localStorage.getItem('theme');
					const theme =
						stored === 'light' || stored === 'dark'
							? stored
							: window.matchMedia('(prefers-color-scheme: dark)').matches
								? 'dark'
								: 'light';
					document.documentElement.dataset.theme = theme;
				} catch {
					document.documentElement.dataset.theme = 'light';
				}
			})();
		</script>
	</head>
	<body>
		<a class="skip-link" href="#main">{t('nav.skip')}</a>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		color-scheme: light;
		--bg: #ffffff;
		--bg-subtle: #f5f6f8;
		--fg: #10131a;
		--fg-muted: #5b6472;
		--border: #e4e7eb;
		--accent: #2f5cff;
		--accent-fg: #ffffff;
	}

	@media (prefers-color-scheme: dark) {
		:root:not([data-theme='light']) {
			color-scheme: dark;
			--bg: #0b0e13;
			--bg-subtle: #151a23;
			--fg: #e9edf4;
			--fg-muted: #98a2b3;
			--border: #242b37;
			--accent: #82a0ff;
			--accent-fg: #0b1020;
		}
	}

	:root[data-theme='dark'] {
		color-scheme: dark;
		--bg: #0b0e13;
		--bg-subtle: #151a23;
		--fg: #e9edf4;
		--fg-muted: #98a2b3;
		--border: #242b37;
		--accent: #82a0ff;
		--accent-fg: #0b1020;
	}

	:root[data-theme='light'] {
		color-scheme: light;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		-webkit-text-size-adjust: 100%;
	}

	body {
		margin: 0;
		min-height: 100dvh;
		background: var(--bg);
		color: var(--fg);
		font-family:
			ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial,
			sans-serif;
		font-size: 16px;
		line-height: 1.6;
		-webkit-font-smoothing: antialiased;
	}

	a {
		color: inherit;
	}

	:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
		border-radius: 6px;
	}

	.skip-link {
		position: absolute;
		left: -9999px;
		top: 0;
		padding: 0.6rem 1rem;
		background: var(--accent);
		color: var(--accent-fg);
		border-radius: 0 0 8px 0;
		z-index: 10;
	}

	.skip-link:focus {
		left: 0;
	}

	@media (prefers-reduced-motion: reduce) {
		*,
		*::before,
		*::after {
			animation-duration: 0.01ms !important;
			transition-duration: 0.01ms !important;
		}
	}
</style>
